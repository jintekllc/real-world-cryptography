---
import { withBase } from '~/lib/url';
---
<header class="sticky top-0 z-10 h-14 bg-[var(--color-surface)] border-b border-[var(--color-surface)]">
  <div class="max-w-3xl mx-auto px-6 h-full flex items-center justify-between">
    <a href={withBase('/')} class="text-sm hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]">Real-World Cryptography</a>
    <nav aria-label="Site" class="flex items-center gap-4 text-sm">
      <a href={withBase('/chapters/')} class="hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]">Chapters</a>
      <a href={withBase('/assessments/part-1-required/')} class="hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]">Part 1 test</a>
      <a href={withBase('/assessments/part-2-required/')} class="hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]">Part 2 test</a>
      <a href={withBase('/assessments/final-exam/')} class="hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]">Final</a>
      <a href={withBase('/coding-project/')} class="hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]">Project</a>
      <span aria-hidden="true" class="text-[var(--color-muted-2)]">·</span>
      <a href={withBase('/reset/')} class="text-[var(--color-muted-2)] hover:text-[var(--color-muted)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]">Reset</a>
    </nav>
  </div>
</header>
