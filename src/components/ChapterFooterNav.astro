---
import { withBase } from '~/lib/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  chapter: CollectionEntry<'chapters'>;
  prev?: CollectionEntry<'chapters'> | undefined;
  next?: CollectionEntry<'chapters'> | undefined;
}
const { chapter, prev, next } = Astro.props;

// Part-boundary detection (D-54).
// Last chapter of Part 1: next undefined OR next.data.part !== 1.
//   -> "Next: Part 1 test ->" -> /assessments/part-1-required/
// Last chapter of Part 2: next undefined.
//   -> "Next: Part 2 test ->" -> /assessments/part-2-required/
// D-101: URL slug uses '-required' (matches Plan 05-01 fixtures); visible
// label uses 'test' (lowercase t per UI-SPEC card-title convention).
const isLastOfPart1 = chapter.data.part === 1 && (next === undefined || next.data.part !== 1);
const isLastOfPart2 = chapter.data.part === 2 && next === undefined;

let nextHref: string | undefined;
let nextLabel: string;
if (isLastOfPart1) {
  nextHref = withBase('/assessments/part-1-required/');
  nextLabel = 'Next: Part 1 test →';
} else if (isLastOfPart2) {
  nextHref = withBase('/assessments/part-2-required/');
  nextLabel = 'Next: Part 2 test →';
} else if (next !== undefined) {
  nextHref = withBase(`/chapters/${next.data.chapter}/`);
  nextLabel = 'Next chapter →';
} else {
  nextHref = undefined;
  nextLabel = '';
}

const prevHref = prev !== undefined ? withBase(`/chapters/${prev.data.chapter}/`) : undefined;

// Per D-58 / Pattern S4, assessment URLs are computed by template-literal convention
// from chapter.data.chapter — chapter pages never read the assessments collection.
const quizHref = withBase(`/assessments/${chapter.data.chapter}-quiz/`);
const challengeHref = withBase(`/assessments/${chapter.data.chapter}-challenge/`);
---
<nav aria-label="Chapter navigation" class="mt-12 bg-[var(--color-surface)] p-6 flex flex-col gap-4">
  <div class="flex flex-row gap-4">
    <span class="inline-flex items-baseline gap-2">
      <a
        href={quizHref}
        class="text-[var(--color-accent)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
      >
        Take the chapter quiz
      </a>
      <span data-rwc-badge={`${chapter.data.chapter}-quiz`}></span>
    </span>
    <span class="inline-flex items-baseline gap-2">
      <a
        href={challengeHref}
        class="text-[var(--color-accent)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
      >
        Take the challenge quiz
      </a>
      <span data-rwc-badge={`${chapter.data.chapter}-challenge`}></span>
    </span>
  </div>
  <div class="flex flex-row justify-between">
    {prevHref && (
      <a
        href={prevHref}
        class="text-[var(--color-accent)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
      >
        ← Previous chapter
      </a>
    )}
    {nextHref && (
      <a
        href={nextHref}
        class="text-[var(--color-accent)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
      >
        {nextLabel}
      </a>
    )}
  </div>
</nav>
