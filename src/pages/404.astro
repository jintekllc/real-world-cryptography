---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { withBase } from '~/lib/url';
---
<BaseLayout title="404 — Real-World Cryptography Course">
  <div class="bg-[var(--color-surface)] px-6 py-8 -mx-6">
    <h1 class="text-3xl font-semibold">404</h1>
    <p class="text-xl font-semibold mt-2">Page not found.</p>
    <p class="text-base font-normal leading-relaxed mt-6">
      That URL does not match any chapter, quiz, test, or page on this site.
    </p>
    <p class="mt-8">
      <a
        href={withBase('/')}
        class="text-[var(--color-accent)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
      >
        Return to home
      </a>
    </p>
  </div>
</BaseLayout>
