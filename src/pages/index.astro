---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout title="Real-World Cryptography Course">
  <h1 class="text-3xl font-semibold">Real-World Cryptography</h1>
  <p class="text-sm font-normal mt-2 text-[var(--color-muted)]">
    An interactive companion to the book by David Wong.
  </p>
  <p class="text-base font-normal leading-relaxed mt-8">
    Phase 1 deploy verification. The course site is being built — chapters,
    quizzes, tests, and the final exam land in subsequent phases.
  </p>
  <p class="mt-8">
    <a
      href="https://github.com/jintekllc/real-world-cryptography"
      class="text-[var(--color-accent)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
    >
      View source on GitHub
    </a>
  </p>
</BaseLayout>
