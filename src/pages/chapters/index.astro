---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ChapterCard from '~/components/ChapterCard.astro';

// D-49: filter ch00 out of the cohort-facing index.
// D-60: page frontmatter MAY call getCollection('chapters') directly.
const cohortChapters = (await getCollection('chapters', (c) => c.data.chapter !== 'ch00'))
  .sort((a, b) => a.data.order - b.data.order);
const part1 = cohortChapters.filter((c) => c.data.part === 1);
const part2 = cohortChapters.filter((c) => c.data.part === 2);
---
<BaseLayout title="Chapters — Real-World Cryptography Course">
  <h1 class="text-3xl font-semibold">Chapters</h1>

  <h2 class="mt-12 text-xl font-semibold">Part 1 — Primitives</h2>
  <ul class="mt-4 space-y-4">
    {part1.map((c) => <li><ChapterCard chapter={c} /></li>)}
  </ul>

  <h2 class="mt-12 text-xl font-semibold">Part 2 — Protocols</h2>
  <ul class="mt-4 space-y-4">
    {part2.map((c) => <li><ChapterCard chapter={c} /></li>)}
  </ul>
</BaseLayout>
